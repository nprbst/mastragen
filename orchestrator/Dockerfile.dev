FROM oven/bun:1-slim

WORKDIR /app

# Install curl for healthcheck and build tools for native dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace root and all workspace package.json files
COPY package.json bun.lock ./
COPY web/package.json ./web/
COPY orchestrator/package.json ./orchestrator/
COPY cli/package.json ./cli/
COPY experiments/package.json ./experiments/

# Install all dependencies (including dev)
RUN bun install --filter './orchestrator'

# Copy source code to orchestrator directory (matching workspace structure)
COPY orchestrator/src ./orchestrator/src

# Create directories for commands and skills (mounted as volumes in dev)
RUN mkdir -p /app/claude-commands /app/claude-skills

# Create data directory
RUN mkdir -p /app/data

EXPOSE 4000

CMD ["bun", "run", "--watch", "orchestrator/src/index.ts"]
