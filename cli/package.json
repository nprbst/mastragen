{
  "name": "mgen",
  "version": "0.1.0",
  "description": "CLI for Mastragen orchestrator",
  "type": "module",
  "private": true,
  "bin": {
    "mgen": "./src/index.ts"
  },
  "scripts": {
    "preflight": "bun run check && bun run test",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome lint src tests",
    "lint:fix": "biome lint --write src tests",
    "format": "biome format --write src tests",
    "check": "biome check src tests && tsc --noEmit",
    "check:fix": "biome check --write src tests"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@orpc/client": "^1.13.4",
    "commander": "^12.0.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
