---
import Layout from '../../layouts/Layout.astro';
import NewSessionForm from '../../components/NewSessionForm';

const orchestratorUrl = import.meta.env.PUBLIC_ORCHESTRATOR_URL || 'http://localhost:4000';
---

<Layout title="Create New Session">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <a
        href="/"
        class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1"
      >
        <span>&larr;</span> Back to Dashboard
      </a>
    </div>

    <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-6">
      <h1 class="text-xl font-semibold text-gray-900 mb-6">Create New Session</h1>
      <p class="text-sm text-gray-500 mb-6">
        Start a new development session by selecting a project and environment.
        Your session will be provisioned with the project's Claude configuration.
      </p>

      <NewSessionForm client:load orchestratorUrl={orchestratorUrl} />
    </div>
  </div>
</Layout>
