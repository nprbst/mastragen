---
import Layout from '../../layouts/Layout.astro';
import NewSessionForm from '../../components/NewSessionForm';
---

<Layout title="Create New Session">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <a
        href="/"
        class="text-sm text-gray-500 dark:text-dark-text-secondary hover:text-gray-700 dark:hover:text-dark-text-primary flex items-center gap-1"
      >
        <span>&larr;</span> Back to Dashboard
      </a>
    </div>

    <div class="bg-white dark:bg-dark-bg-secondary shadow-sm dark:shadow-none rounded-lg border border-gray-200 dark:border-dark-border p-6">
      <h1 class="text-xl font-semibold text-gray-900 dark:text-dark-text-primary mb-6">Create New Session</h1>
      <p class="text-sm text-gray-500 dark:text-dark-text-secondary mb-6">
        Start a new development session by selecting a project and environment.
        Your session will be provisioned with the project's Claude configuration.
      </p>

      <NewSessionForm client:load />
    </div>
  </div>
</Layout>
