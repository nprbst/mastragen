# GitHub (required for private repos)
GITHUB_TOKEN=ghp_...

# Claude API (choose one)
# Option 1: Anthropic API directly
ANTHROPIC_API_KEY=sk-ant-...

# Option 2: AWS Bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Database (optional, defaults to ./data/mastragen.db)
# DATABASE_PATH=./data/mastragen.db

# Server (optional, defaults shown)
# PORT=3000
# HOST=0.0.0.0
